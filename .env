# ============================================================
# FILE: backend/.env
# DESKRIPSI: Environment variables untuk backend E-SOPRA VPS
#
# !! PENTING: File ini TIDAK BOLEH di-commit ke Git !!
#    Sudah ditambahkan ke .gitignore
#
# CARA PAKAI DI VPS:
#   1. Upload file ini ke VPS di folder: /path/project/backend/.env
#   2. Isi DB_PASSWORD dengan password MySQL di VPS Anda
#   3. Jalankan: pm2 start ecosystem.config.js --env production
# ============================================================

# ===========================
# MySQL Database
# ===========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sop_bps
DB_USER=root
# ↓↓↓ ISI INI DENGAN PASSWORD MYSQL DI VPS ANDA ↓↓↓
DB_PASSWORD=

# ===========================
# JWT Authentication
# ===========================
# [SECURITY] Sudah di-generate secara cryptographically secure (128 karakter hex)
# JANGAN UBAH nilai ini setelah ada user yang login — semua sesi akan invalid
JWT_SECRET=d86263b2f3b1bb5323e4749ea029d793871174f2d87fd6d961de7dab38756e55e15e8085e146e377f5d5698e002cb54ec1f52fef351237943ce82773079813fe
JWT_EXPIRES_IN=8h

# ===========================
# Server
# ===========================
NODE_ENV=production
PORT=8000
FRONTEND_URL=https://backendsop.serverbpsjosjis.dpdns.org
